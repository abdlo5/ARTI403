   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1ddb2145",
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "img = cv2.imread('./images/input.jpg')\n",
    "gray_img = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
    "cv2.imshow('Grayscale image', gray_img)\n",
    "cv2.waitKey()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f108b4ee",
   "metadata": {},
   "source": [
    "## 0. Load the Image (`fabio_gray_512`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bd545b6e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img_path = 'images/fabio_gray_512.tif'\n",
    "img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)\n",
    "h, w = img.shape\n",
    "print(f\"Loaded image: {img_path}, dimensions: {w}x{h}\")\n",
    "\n",
    "plt.figure(figsize=(4, 4))\n",
    "plt.imshow(img, cmap='gray')\n",
    "plt.title(f\"Original: fabio_gray_512 ({w}x{h})\")\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "17d6abfe",
   "metadata": {},
   "source": [
    "### Task 1.1: Increase the Size of the Image (Scaling / Resizing)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c85d0220",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Increase the size by 1.5x (from 512x512 to 768x768)\n",
    "scale_factor = 1.5\n",
    "new_w, new_h = int(w * scale_factor), int(h * scale_factor)\n",
    "img_enlarged = cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_CUBIC)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(9, 4))\n",
    "axes[0].imshow(img, cmap='gray')\n",
    "axes[0].set_title(f\"Original ({w}x{h})\")\n",
    "axes[0].axis('off')\n",
    "\n",
    "axes[1].imshow(img_enlarged, cmap='gray')\n",
    "axes[1].set_title(f\"Enlarged 1.5x ({new_w}x{new_h})\")\n",
    "axes[1].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "91cbcf99",
   "metadata": {},
   "source": [
    "### Task 1.2: Rotate the Image by 120 Degrees"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ccd8ac05",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Rotate around center by 120 degrees\n",
    "center = (w // 2, h // 2)\n",
    "rot_mat = cv2.getRotationMatrix2D(center, angle=120, scale=1.0)\n",
    "img_rotated = cv2.warpAffine(img, rot_mat, (w, h))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(9, 4))\n",
    "axes[0].imshow(img, cmap='gray')\n",
    "axes[0].set_title(\"Original\")\n",
    "axes[0].axis('off')\n",
    "\n",
    "axes[1].imshow(img_rotated, cmap='gray')\n",
    "axes[1].set_title(\"Rotated by 120°\")\n",
    "axes[1].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "802de5d8",
   "metadata": {},
   "source": [
    "### Task 1.3: Perform Shear Operations Over the Image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a02585f0",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Horizontal shear: x' = x + sx * y, y' = y\n",
    "shear_x = 0.2\n",
    "M_shear_x = np.float32([\n",
    "    [1, shear_x, 0],\n",
    "    [0, 1,       0]\n",
    "])\n",
    "sheared_w = int(w + shear_x * h)\n",
    "img_sheared_x = cv2.warpAffine(img, M_shear_x, (sheared_w, h))\n",
    "\n",
    "# Vertical shear: x' = x, y' = y + sy * x\n",
    "shear_y = 0.2\n",
    "M_shear_y = np.float32([\n",
    "    [1,       0, 0],\n",
    "    [shear_y, 1, 0]\n",
    "])\n",
    "sheared_h = int(h + shear_y * w)\n",
    "img_sheared_y = cv2.warpAffine(img, M_shear_y, (w, sheared_h))\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(13, 4))\n",
    "axes[0].imshow(img, cmap='gray')\n",
    "axes[0].set_title(\"Original\")\n",
    "axes[0].axis('off')\n",
    "\n",
    "axes[1].imshow(img_sheared_x, cmap='gray')\n",
    "axes[1].set_title(f\"Horizontal Shear (sx={shear_x})\")\n",
    "axes[1].axis('off')\n",
    "\n",
    "axes[2].imshow(img_sheared_y, cmap='gray')\n",
    "axes[2].set_title(f\"Vertical Shear (sy={shear_y})\")\n",
    "axes[2].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1cecfbf0",
   "metadata": {},
   "source": [
    "### Task 2.1: Create a Negative Image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9e4d07bd",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Negative Transformation: s = (L - 1) - r = 255 - r\n",
    "img_negative = 255 - img\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(9, 4))\n",
    "axes[0].imshow(img, cmap='gray')\n",
    "axes[0].set_title(\"Original\")\n",
    "axes[0].axis('off')\n",
    "\n",
    "axes[1].imshow(img_negative, cmap='gray')\n",
    "axes[1].set_title(\"Negative Image (255 - r)\")\n",
    "axes[1].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d7350b72",
   "metadata": {},
   "source": [
    "### Task 2.2: Log Transformation (with appropriate constant c)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "740330fe",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Log Transformation: s = c * log(1 + r)\n",
    "# Constant c scales maximum output to 255: c = 255 / log(1 + r_max)\n",
    "r_max = np.max(img)\n",
    "c = 255.0 / np.log(1.0 + r_max)\n",
    "img_log = np.array(c * np.log(1.0 + img.astype(np.float64)), dtype=np.uint8)\n",
    "\n",
    "print(f\"Max pixel value (r_max): {r_max}\")\n",
    "print(f\"Calculated scaling constant c: {c:.2f}\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(9, 4))\n",
    "axes[0].imshow(img, cmap='gray')\n",
    "axes[0].set_title(\"Original\")\n",
    "axes[0].axis('off')\n",
    "\n",
    "axes[1].imshow(img_log, cmap='gray')\n",
    "axes[1].set_title(f\"Log Transformed (c = {c:.2f})\")\n",
    "axes[1].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "40b4c0ae",
   "metadata": {},
   "source": [
    "### Task 2.3: Power-law (Gamma) Transformation (increasing contrast)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d9ce2e18",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Power-law (Gamma) Transformation: s = 255 * (r / 255) ** gamma\n",
    "# A gamma > 1 (e.g. gamma = 1.8) increases the contrast by expanding bright/mid values and darkening shadows\n",
    "gamma_contrast = 1.8\n",
    "img_gamma = np.array(255.0 * ((img / 255.0) ** gamma_contrast), dtype=np.uint8)\n",
    "\n",
    "# For comparison, gamma < 1 (e.g. gamma = 0.5) brightens dark shadows\n",
    "gamma_bright = 0.5\n",
    "img_gamma_bright = np.array(255.0 * ((img / 255.0) ** gamma_bright), dtype=np.uint8)\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(13, 4))\n",
    "axes[0].imshow(img, cmap='gray')\n",
    "axes[0].set_title(\"Original\")\n",
    "axes[0].axis('off')\n",
    "\n",
    "axes[1].imshow(img_gamma, cmap='gray')\n",
    "axes[1].set_title(f\"Gamma = {gamma_contrast} (High Contrast)\")\n",
    "axes[1].axis('off')\n",
    "\n",
    "axes[2].imshow(img_gamma_bright, cmap='gray')\n",
    "axes[2].set_title(f\"Gamma = {gamma_bright} (Shadow Boost)\")\n",
    "axes[2].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
